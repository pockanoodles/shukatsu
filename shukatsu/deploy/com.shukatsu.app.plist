<?xml version="1.0" encoding="UTF-8"?>
<!-- launchd agent for shukatsud (the app, the API, MCP, calendar feeds, and connector sync) on a Mac.
       Build first: cd shukatsu && npm run build.
       cp shukatsu/deploy/com.shukatsu.app.plist ~/Library/LaunchAgents/
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.shukatsu.app.plist
       tail -f ~/Library/Logs/shukatsu.log
     Edit the paths (and the node path: `which node`) to match this machine. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.shukatsu.app</string>
  <key>WorkingDirectory</key><string>/Users/USER/Projects/shukatsu/shukatsu</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>shukatsud.mjs</string>
    <string>--port</string><string>3000</string>
    <string>--host</string><string>127.0.0.1</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict><key>NODE_ENV</key><string>production</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/Users/USER/Library/Logs/shukatsu.log</string>
  <key>StandardErrorPath</key><string>/Users/USER/Library/Logs/shukatsu.log</string>
</dict>
</plist>
