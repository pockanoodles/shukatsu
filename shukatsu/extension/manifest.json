{
  "manifest_version": 3,
  "name": "shukatsu",
  "version": "0.1.0",
  "description": "Reads the job board pages you open (NUworks, Handshake, CareerForum.Net) into your own shukatsu, and fills application forms on Greenhouse, Lever, and Ashby when you press Fill. It never makes a request to a board, never submits, and copies nothing from LinkedIn.",
  "permissions": [
    "activeTab",
    "contextMenus",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "https://greenhouse.io/*",
    "https://*.greenhouse.io/*",
    "https://lever.co/*",
    "https://*.lever.co/*",
    "https://ashbyhq.com/*",
    "https://*.ashbyhq.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://northeastern-csm.symplicity.com/*",
        "https://*.northeastern-csm.symplicity.com/*",
        "https://joinhandshake.com/*",
        "https://*.joinhandshake.com/*",
        "https://careerforum.net/*",
        "https://*.careerforum.net/*"
      ],
      "js": [
        "reader.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Send this page to shukatsu"
  },
  "options_page": "options.html",
  "commands": {
    "fill": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Fill this application form"
    },
    "preview": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Preview the fill: what would go where, nothing written"
    }
  }
}
