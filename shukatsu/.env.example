# shukatsu app settings. Copy to shukatsu/.env (gitignored); `next start` reads it.

# The address people open. Invite links, passkeys, and secure cookies all key off it.
# Tailscale Serve:   https://<machine>.<tailnet>.ts.net
# Cloudflare Tunnel: https://shukatsu.example.com
SHUKATSU_URL=http://localhost:3000

# Hosts a reverse proxy or tunnel serves the app under (comma-separated), so server
# actions accept them. Usually the host part of SHUKATSU_URL.
SHUKATSU_ALLOWED_ORIGINS=

# The private data root (career-profile.yml, tracker, manifests). Optional when the
# repo's .career-ops-data marker already points at it.
CAREER_OPS_DATA_DIR=

# Keeps open forms working across rebuilds and restarts. Generate once:
#   openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Optional. Turns on AI wordings in packets (one bullet + the posting per call, logged
# to {DATA_ROOT}/.shukatsu/egress.log). Leave empty to keep everything on the machine.
ANTHROPIC_API_KEY=
SHUKATSU_MODEL=claude-opus-5-5

# Set to 0 to stop committing confirmed changes to the data root's git history.
SHUKATSU_GIT=1
