# shukatsu app settings. Copy to shukatsu/.env (gitignored); `next start` reads it.

# The address people open. Invite links, passkeys, and secure cookies all key off it.
# Tailscale Serve:   https://<machine>.<tailnet>.ts.net
# Cloudflare Tunnel: https://shukatsu.example.com
SHUKATSU_URL=http://localhost:3000

# Hosts a reverse proxy or tunnel serves the app under (comma-separated), so server
# actions accept them. Usually the host part of SHUKATSU_URL.
SHUKATSU_ALLOWED_ORIGINS=

# The private data root (career-profile.yml, tracker, manifests). Optional when the
# repo's .career-ops-data marker already points at it.
CAREER_OPS_DATA_DIR=

# Keeps open forms working across rebuilds and restarts. Generate once:
#   openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Optional. Turns on AI wordings in packets (one bullet + the posting per call, logged
# to {DATA_ROOT}/.shukatsu/egress.log). Leave empty to keep everything on the machine.
ANTHROPIC_API_KEY=
SHUKATSU_MODEL=claude-opus-5-5

# Where the daemon listens is not set here, because it reads HOST and PORT (or --host and
# --port) before this file loads. It defaults to 127.0.0.1:3000, and the service files in
# deploy/ pass the same. A tunnel or tailnet reaches it from there.

# The zone your deadlines and interview times are shown in. Defaults to this machine's.
SHUKATSU_TZ=

# Key for the credentials connectors store (mail and calendar sign-ins). Normally the Mac
# Keychain, or ~/.config/shukatsu/sync.key on Linux, holds it. Set one of these for a
# container or a headless box. SHUKATSU_SYNC_KEY is base64 of 32 random bytes.
#   openssl rand -base64 32
SHUKATSU_SYNC_KEY=
SHUKATSU_SYNC_KEY_FILE=

# Only when the engine checkout is not the parent of shukatsu/.
SHUKATSU_ENGINE=

# For the CLIs and the stdio MCP bridge, never the daemon: an agent key from Settings, Agents.
# SHUKATSU_TOKEN=shk_agent_...

# Set to 0 to stop committing confirmed changes to the data root's git history.
SHUKATSU_GIT=1
