{
  "name": "shukatsu",
  "version": "0.1.0",
  "private": true,
  "description": "The shukatsu fork's engine and app: one master profile, every resume a selection from it, every change reviewed.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node shukatsud.mjs --dev",
    "dev:next": "NEXT_TELEMETRY_DISABLED=1 next dev",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NODE_ENV=production node shukatsud.mjs",
    "mcp": "node mcp-stdio.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/*.spec.mjs\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
